{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-v2.schema.json",
  "title": "Pi-PLS flat synthetic benchmark CSV record, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "tier",
    "scenario_id",
    "seed",
    "method_id",
    "status",
    "python_version",
    "pipls_version",
    "numpy_version",
    "scikit_learn_version",
    "scale",
    "n_components",
    "predictor_rank",
    "svd_solver",
    "random_state",
    "search_method",
    "max_predictor_rank",
    "samples_per_predictor_rank",
    "scoring",
    "cv_splitter",
    "cv_n_splits",
    "cv_shuffle",
    "cv_random_state",
    "n_jobs",
    "parallel_backend",
    "native_threads_per_worker",
    "response_standardized_mse",
    "r2_uniform_average",
    "selected_n_components",
    "selected_predictor_rank",
    "n_components_absolute_error_from_declared_shared_rank",
    "predictor_rank_absolute_error_from_declared_signal_rank",
    "predictor_shared_capture",
    "predictor_signal_capture",
    "response_shared_capture",
    "prediction_relative_difference",
    "coefficient_relative_difference",
    "fit_time_seconds",
    "predict_time_seconds",
    "peak_rss_bytes_optional",
    "message"
  ],
  "x-csv": {
    "encoding": "utf-8",
    "delimiter": ",",
    "header": true,
    "null": "",
    "columns": [
      "schema_version",
      "suite_id",
      "tier",
      "scenario_id",
      "seed",
      "method_id",
      "status",
      "python_version",
      "pipls_version",
      "numpy_version",
      "scikit_learn_version",
      "scale",
      "n_components",
      "predictor_rank",
      "svd_solver",
      "random_state",
      "search_method",
      "max_predictor_rank",
      "samples_per_predictor_rank",
      "scoring",
      "cv_splitter",
      "cv_n_splits",
      "cv_shuffle",
      "cv_random_state",
      "n_jobs",
      "parallel_backend",
      "native_threads_per_worker",
      "response_standardized_mse",
      "r2_uniform_average",
      "selected_n_components",
      "selected_predictor_rank",
      "n_components_absolute_error_from_declared_shared_rank",
      "predictor_rank_absolute_error_from_declared_signal_rank",
      "predictor_shared_capture",
      "predictor_signal_capture",
      "response_shared_capture",
      "prediction_relative_difference",
      "coefficient_relative_difference",
      "fit_time_seconds",
      "predict_time_seconds",
      "peak_rss_bytes_optional",
      "message"
    ]
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "skipped",
        "failed"
      ]
    },
    "python_version": {
      "type": "string",
      "minLength": 1
    },
    "pipls_version": {
      "type": "string",
      "minLength": 1
    },
    "numpy_version": {
      "type": "string",
      "minLength": 1
    },
    "scikit_learn_version": {
      "type": "string",
      "minLength": 1
    },
    "scale": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "n_components": {
      "type": [
        "integer",
        "null"
      ]
    },
    "predictor_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "svd_solver": {
      "type": [
        "string",
        "null"
      ]
    },
    "random_state": {
      "type": [
        "integer",
        "null"
      ]
    },
    "search_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_predictor_rank": {
      "type": [
        "string",
        "null"
      ]
    },
    "samples_per_predictor_rank": {
      "type": [
        "number",
        "null"
      ]
    },
    "scoring": {
      "type": [
        "string",
        "null"
      ]
    },
    "cv_splitter": {
      "type": [
        "string",
        "null"
      ]
    },
    "cv_n_splits": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cv_shuffle": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "cv_random_state": {
      "type": [
        "integer",
        "null"
      ]
    },
    "n_jobs": {
      "type": [
        "integer",
        "null"
      ]
    },
    "parallel_backend": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_threads_per_worker": {
      "type": [
        "integer",
        "null"
      ]
    },
    "response_standardized_mse": {
      "type": [
        "number",
        "null"
      ]
    },
    "r2_uniform_average": {
      "type": [
        "number",
        "null"
      ]
    },
    "selected_n_components": {
      "type": [
        "integer",
        "null"
      ]
    },
    "selected_predictor_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "n_components_absolute_error_from_declared_shared_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "predictor_rank_absolute_error_from_declared_signal_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "predictor_shared_capture": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "predictor_signal_capture": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "response_shared_capture": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "prediction_relative_difference": {
      "type": [
        "number",
        "null"
      ]
    },
    "coefficient_relative_difference": {
      "type": [
        "number",
        "null"
      ]
    },
    "fit_time_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0
    },
    "predict_time_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0
    },
    "peak_rss_bytes_optional": {
      "type": [
        "integer",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
