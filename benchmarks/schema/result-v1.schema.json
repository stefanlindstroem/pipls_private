{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-v1.schema.json",
  "title": "Pi-PLS synthetic benchmark result record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "tier",
    "scenario_id",
    "seed",
    "method_id",
    "status",
    "versions",
    "parameters",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "tier": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "method_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "skipped", "failed"]},
    "versions": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "required": ["python", "pipls", "numpy", "scikit_learn"]
    },
    "parameters": {"type": "object"},
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "null"]
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "integer", "null"]}
    },
    "message": {"type": ["string", "null"]}
  }
}
